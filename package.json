{
  "name": "usb-device-tree",
  "displayName": "USB Device Tree",
  "description": "Browse Windows USB controllers, hubs, ports, and connected devices in VS Code.",
  "icon": "resources/extension-icon.png",
  "version": "0.14.0",
  "publisher": "brian-chang",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrianChang1212/vscode-usb-device-tree.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:usbDeviceTree.devices",
    "onCommand:usbDeviceTree.expandAll",
    "onCommand:usbDeviceTree.refresh",
    "onCommand:usbDeviceTree.search",
    "onCommand:usbDeviceTree.exportSnapshot"
  ],
  "main": "./source/extension.js",
  "l10n": "./l10n",
  "files": [
    "source/",
    "resources/",
    "docs/",
    "native/bin/win32-x64/usb-topology.exe",
    "l10n/",
    "package.nls.json",
    "package.nls.zh-tw.json",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/build.ps1",
    "test": "node --test test/*.test.js",
    "vscode:prepublish": "npm run build:native",
    "package:verify": "node -e \"require('node:fs').mkdirSync('release', { recursive: true })\" && vsce package --allow-missing-repository --out release/usb-device-tree.vsix && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-vsix.ps1 release/usb-device-tree.vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "usbDeviceTree.expandAll",
        "title": "%command.expandAll.title%",
        "icon": "$(chevron-down)"
      },
      {
        "command": "usbDeviceTree.refresh",
        "title": "%command.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "usbDeviceTree.search",
        "title": "%command.search.title%",
        "icon": "$(search)"
      },
      {
        "command": "usbDeviceTree.exportSnapshot",
        "title": "%command.exportSnapshot.title%",
        "icon": "$(export)"
      },
      {
        "command": "usbDeviceTree.pauseAutoRefresh",
        "title": "%command.pauseAutoRefresh.title%",
        "icon": "$(debug-pause)"
      },
      {
        "command": "usbDeviceTree.resumeAutoRefresh",
        "title": "%command.resumeAutoRefresh.title%",
        "icon": "$(play)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "usbDeviceTree",
          "title": "%viewsContainer.usbDeviceTree.title%",
          "icon": "resources/usb-device-tree.svg"
        }
      ]
    },
    "views": {
      "usbDeviceTree": [
        {
          "id": "usbDeviceTree.devices",
          "name": "%view.devices.name%",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "usbDeviceTree.expandAll",
          "when": "view == usbDeviceTree.devices",
          "group": "navigation"
        },
        {
          "command": "usbDeviceTree.refresh",
          "when": "view == usbDeviceTree.devices",
          "group": "navigation"
        },
        {
          "command": "usbDeviceTree.search",
          "when": "view == usbDeviceTree.devices",
          "group": "navigation"
        },
        {
          "command": "usbDeviceTree.exportSnapshot",
          "when": "view == usbDeviceTree.devices",
          "group": "navigation"
        },
        {
          "command": "usbDeviceTree.pauseAutoRefresh",
          "when": "view == usbDeviceTree.devices && !usbDeviceTree.autoRefreshPaused",
          "group": "navigation@1"
        },
        {
          "command": "usbDeviceTree.resumeAutoRefresh",
          "when": "view == usbDeviceTree.devices && usbDeviceTree.autoRefreshPaused",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "usbDeviceTree.expandAll",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "usbDeviceTree.autoRefreshEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%config.autoRefreshEnabled.description%"
        },
        "usbDeviceTree.refreshIntervalSeconds": {
          "type": "integer",
          "default": 5,
          "minimum": 2,
          "maximum": 60,
          "scope": "application",
          "description": "%config.refreshIntervalSeconds.description%"
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  }
}
